{%
/**
 * @typedef {object} RuleOptions
 * @property {integer} forwardPort DNS 转发端口，0 表示关闭。
 * @property {string} user 代理服务用户，由内部生成器固定。
 */
/** @global {RuleOptions} options 由 generate.uc 注入的已校验字段。 */
%}
{# 本文件只包含 dns-forward-output 链内规则；链声明、hook 和优先级由内部模板负责。 -#}
{# DNS 服务和代理核心的上游查询不参与转发，避免递归 -#}
meta skgid {{ sprintf("%J", options.user) }} counter return

{# 仅转发路由器发往本机 53 端口的系统 DNS 查询 -#}
fib daddr type local meta l4proto { tcp, udp } th dport 53 counter redirect to :{{ options.forwardPort }}
