{%
/**
 * @typedef {object} RuleOptions
 * @property {boolean} allowAll 是否默认允许所有客户端。
 * @property {string} excludedInterfaceNames 已引用并转义的排除接口列表。
 * @property {string[]} excludedInterfaces 排除的接口。
 * @property {string[]} excludedMacs 排除的 MAC。
 * @property {integer} forwardPort DNS 转发端口，0 表示关闭。
 * @property {string} interfaceNames 已引用并转义的允许接口列表。
 * @property {string[]} interfaces 允许代理的接口。
 * @property {string[]} macs 允许代理的 MAC。
 * @property {string[]} wan WAN 设备名。
 * @property {string} wanNames 已引用并转义的 WAN 设备列表。
 */
/** @global {RuleOptions} options 由 generate.uc 注入的已校验字段。 */
%}
{# 本文件只包含 dns-forward 链内规则；链声明、hook 和优先级由内部模板负责。 -#}
# WAN 入站流量不参与 DNS 转发
{% if (length(options.wan)): %}
iifname { {{ options.wanNames }} } counter return
{% endif %}

# 仅转发透明代理 ACL 选中的客户端 DNS 查询
{# 白名单使用接口或 MAC 任一匹配；两项都空时没有客户端被选中。 -#}
{% if (!options.allowAll): %}
{% if (length(options.interfaces) && length(options.macs)): %}
iif != { {{ options.interfaceNames }} } ether saddr != { {{ join(', ', options.macs) }} } counter return
{% elif (length(options.interfaces)): %}
iif != { {{ options.interfaceNames }} } counter return
{% elif (length(options.macs)): %}
ether saddr != { {{ join(', ', options.macs) }} } counter return
{% else %}
counter return
{% endif %}
{% endif %}
{% if (options.allowAll && length(options.excludedInterfaces)): %}
iif { {{ options.excludedInterfaceNames }} } counter return
{% endif %}
{% if (options.allowAll && length(options.excludedMacs)): %}
ether saddr { {{ join(', ', options.excludedMacs) }} } counter return
{% endif %}
meta l4proto { tcp, udp } th dport 53 counter redirect to :{{ options.forwardPort }}
