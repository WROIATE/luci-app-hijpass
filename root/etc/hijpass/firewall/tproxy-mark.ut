{%
/**
 * @typedef {object} RuleOptions
 * @property {integer} proxyMark 透明代理标记，由内部生成器固定。
 * @property {integer} shuntMark 分流标记，由内部生成器固定。
 */
/** @global {RuleOptions} options 由 generate.uc 注入的已校验字段。 */
%}
{# 本文件只包含 tproxy-mark 链内规则；链声明、hook 和优先级由内部模板负责。 -#}
{# 根据 ct mark 设置 meta mark -#}
ct mark { {{ options.proxyMark }}, {{ options.shuntMark }} } meta mark set {{ options.proxyMark }}
