table inet hijpass {
    chain pre-mangle {
        type filter hook prerouting priority mangle - 1; policy accept;
        meta l4proto $TPROXY_PROTO socket transparent 1 meta mark set $TPROXY_MARK counter
        ip daddr @bypass4list counter return
        ip6 daddr @bypass6list counter return
        meta l4proto $TPROXY_PROTO counter tproxy to :$TPROXY_PORT meta mark set $TPROXY_MARK accept
    }

    chain out-mangle {
        type route hook output priority mangle - 1; policy accept;
        meta l4proto != $TPROXY_PROTO counter return
        meta skgid $HIJPASS_USER counter return
        ip daddr @bypass4list counter return
        ip6 daddr @bypass6list counter return
        meta mark set $TPROXY_MARK counter
    }

    set bypass4list {
        type ipv4_addr
        flags interval
        auto-merge
        elements = $IP_V4_LIST
    }

    set bypass6list {
        type ipv6_addr
        flags interval
        auto-merge
        elements = $IP_V6_LIST
    }
}