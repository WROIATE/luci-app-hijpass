{%
/**
 * @typedef {object} AddressLists
 * @property {string[]} direct 绕过代理的地址。
 * @property {string[]} proxy 强制代理的地址。
 * @property {string[]} china 国内路由地址。
 */
/**
 * @typedef {object} FirewallOptions
 * @property {integer} proxyPort 单节点透明代理端口，0 表示关闭。
 * @property {integer} shuntPort 分流透明代理端口，0 表示关闭。
 * @property {integer} forwardPort DNS 转发端口，0 表示关闭。
 * @property {string[]} protocols tcp/udp 协议。
 * @property {string[]} wan WAN 设备名。
 * @property {string[]} interfaces 允许代理的接口。
 * @property {string[]} excludedInterfaces 排除的接口。
 * @property {string[]} macs 允许代理的 MAC。
 * @property {string[]} excludedMacs 排除的 MAC。
 * @property {boolean} proxyLocal 是否代理路由器自身。
 * @property {boolean} allowAll 是否默认允许所有客户端。
 * @property {boolean} useChnRoute 是否启用国内路由绕过。
 * @property {boolean} useChn 是否启用国内域名集合。
 * @property {boolean} useGfw 是否启用代理域名集合。
 * @property {boolean} domainSets 是否启用自定义 DNS 域名集合。
 * @property {AddressLists} ip4 IPv4 地址列表。
 * @property {AddressLists} ip6 IPv6 地址列表。
 */
/** @global {FirewallOptions} options 由 generate.uc 注入。 */
/**
 * @param {string[]} names
 * @returns {string}
 */
function quoteNames(names) {
    // nft 的接口名需要字符串引用，保留转义，避免把设备名当成规则语法。
    return join(', ', map(names, name => sprintf('%J', name)));
}
%}
{# options 是已校验的 FirewallOptions；模板只决定配置行和链、集合是否输出。 -#}
{% if (options.forwardPort): %}
define DNS_FORWARD_PORT = {{ options.forwardPort }}
{% endif %}
define HIJPASS_USER = hijpass
define TPROXY_MARK = 0x1
define TPROXY_SHUNT_MARK = 0x3
{% if (options.proxyPort): %}
define TPROXY_PORT = {{ options.proxyPort }}
{% endif %}
{% if (options.shuntPort): %}
define TPROXY_SHUNT_PORT = {{ options.shuntPort }}
{% endif %}
define TPROXY_PROTO = { {{ join(', ', options.protocols) }} }
define WAN_DEV = { {{ quoteNames(options.wan) }} }
define PROXY_INTERFACE = { {{ quoteNames(options.interfaces) }} }
define PROXY_INTERFACE_EXCLUDE = { {{ quoteNames(options.excludedInterfaces) }} }
define PROXY_MAC = { {{ join(', ', options.macs) }} }
define PROXY_MAC_EXCLUDE = { {{ join(', ', options.excludedMacs) }} }
define IP4_DIRECT_NFT_LIST = { {{ join(', ', options.ip4.direct) }} }
define IP4_PROXY_NFT_LIST = { {{ join(', ', options.ip4.proxy) }} }
define IP4_CHNROUTE_LIST = { {{ join(', ', options.ip4.china) }} }
define IP6_DIRECT_NFT_LIST = { {{ join(', ', options.ip6.direct) }} }
define IP6_PROXY_NFT_LIST = { {{ join(', ', options.ip6.proxy) }} }
define IP6_CHNROUTE_LIST = { {{ join(', ', options.ip6.china) }} }

table inet hijpass {
    # 防火墙配置不建议轻度用户修改，否则容易引发网络故障
    chain pre-filter {
        type filter hook prerouting priority filter - 50; policy accept;

        # 过滤来源非本地内网的请求
        # fib saddr type != local iif != br-lan counter return

        # 过滤访问本地的请求
        fib daddr type local counter return

        # WAN 入站流量不参与透明代理
        {% if (length(options.wan)): %}
        iifname $WAN_DEV counter return
        {% endif %}

        {% if (!options.allowAll): %}
        iif != @proxy_interface_list ether saddr != @proxy_mac_list counter return
        {% endif %}
        {% if ((options.allowAll && length(options.excludedInterfaces))): %}
        iif @proxy_interface_exclude_list counter return
        {% endif %}
        {% if ((options.allowAll && length(options.excludedMacs))): %}
        ether saddr @proxy_mac_exclude_list counter return
        {% endif %}

        # 过滤回包
        ct direction reply counter return

        # 不满足代理协议，返回原链
        meta l4proto != $TPROXY_PROTO counter return

        # 新连接设置代理、分流标记
        ct state new,related counter jump tproxy-shunt

        # 未标记连接，返回原链
        ct mark != { $TPROXY_MARK, $TPROXY_SHUNT_MARK } counter return

        # 仅代理常用端口
        counter jump proxy-port-filter

        # 代理标记，通过代理节点进行透明代理
        {% if (options.proxyPort): %}
        meta l4proto $TPROXY_PROTO ct mark $TPROXY_MARK tproxy to :$TPROXY_PORT meta mark set $TPROXY_MARK counter accept
        {% endif %}

        # 分流、代理标记，通过分流节点进行透明代理
        {% if (options.shuntPort): %}
        meta l4proto $TPROXY_PROTO ct mark { $TPROXY_MARK, $TPROXY_SHUNT_MARK } tproxy to :$TPROXY_SHUNT_PORT meta mark set $TPROXY_MARK counter
        {% endif %}
    }

    {% if (options.proxyLocal): %}
    chain out-route {
        type route hook output priority filter - 50; policy accept;

        fib daddr type local counter return
        ct direction reply counter return
        meta l4proto != $TPROXY_PROTO counter return
        meta skgid $HIJPASS_USER counter return

        ct state new,related counter jump tproxy-shunt

        counter jump proxy-port-filter
        counter jump tproxy-mark
    }
    {% endif %}

    chain tproxy-shunt {
        ct mark { $TPROXY_MARK, $TPROXY_SHUNT_MARK } return

        ip daddr @proxy4list ct mark set $TPROXY_MARK counter return
        ip6 daddr @proxy6list ct mark set $TPROXY_MARK counter return
        {% if ((options.domainSets)): %}
        ip daddr @dnsproxy4list ct mark set $TPROXY_MARK counter return
        {% endif %}
        {% if ((options.domainSets)): %}
        ip6 daddr @dnsproxy6list ct mark set $TPROXY_MARK counter return
        {% endif %}

        ip daddr @bypass4list counter return
        ip6 daddr @bypass6list counter return
        {% if ((options.domainSets)): %}
        ip daddr @dnsbypass4list counter return
        {% endif %}
        {% if ((options.domainSets)): %}
        ip6 daddr @dnsbypass6list counter return
        {% endif %}

        {% if ((options.useGfw)): %}
        ip daddr @gfw4list counter ct mark set $TPROXY_MARK counter return
        {% endif %}
        {% if ((options.useGfw)): %}
        ip6 daddr @gfw6list counter ct mark set $TPROXY_MARK counter return
        {% endif %}

        {% if ((options.useChn) && options.shuntPort): %}
        ip daddr @chn4list counter return
        {% endif %}
        {% if ((options.useChn) && options.shuntPort): %}
        ip6 daddr @chn6list counter return
        {% endif %}

        {% if ((options.useChnRoute) && options.shuntPort): %}
        ip daddr @chnroute4list counter return
        {% endif %}
        {% if ((options.useChnRoute) && options.shuntPort): %}
        ip6 daddr @chnroute6list counter return
        {% endif %}

        {% if (options.shuntPort): %}
        ct mark set $TPROXY_SHUNT_MARK counter comment "shunt mark"
        {% endif %}
    }

    chain tproxy-mark {
        # 根据 ct mark 设置 meta mark
        ct mark { $TPROXY_MARK, $TPROXY_SHUNT_MARK } meta mark set $TPROXY_MARK
    }

    chain proxy-port-filter {
        # 禁止quic代理
        meta l4proto udp udp dport 443 counter reject

        # 不代理非DNS的UDP请求
        meta l4proto udp udp dport != 53 ct mark set 0 counter return

        # 非指定代理请求，仅代理常用TCP端口
        meta l4proto tcp ct mark != $TPROXY_MARK tcp dport != { 22, 25, 53, 143, 465, 587, 853, 993, 995, 80, 443} ct mark set 0 counter return
    }

    {% if (options.forwardPort): %}
    chain dns-forward {
        type nat hook prerouting priority dstnat - 1; policy accept;

        # WAN 入站流量不参与 DNS 转发
        {% if (length(options.wan)): %}
        iifname $WAN_DEV counter return
        {% endif %}

        # 仅转发透明代理 ACL 选中的客户端 DNS 查询
        {% if (!options.allowAll): %}
        iif != @proxy_interface_list ether saddr != @proxy_mac_list counter return
        {% endif %}
        {% if ((options.allowAll && length(options.excludedInterfaces))): %}
        iif @proxy_interface_exclude_list counter return
        {% endif %}
        {% if ((options.allowAll && length(options.excludedMacs))): %}
        ether saddr @proxy_mac_exclude_list counter return
        {% endif %}
        meta l4proto { tcp, udp } th dport 53 counter redirect to :$DNS_FORWARD_PORT
    }
    {% endif %}

    {% if (options.forwardPort && options.proxyLocal): %}
    chain dns-forward-output {
        # output 用数值优先级，兼容不接受 output/dstnat 命名优先级的 nft 版本。
        type nat hook output priority -101; policy accept;

        # DNS 服务和代理核心的上游查询不参与转发，避免递归
        meta skgid $HIJPASS_USER counter return

        # 仅转发路由器发往本机 53 端口的系统 DNS 查询
        fib daddr type local meta l4proto { tcp, udp } th dport 53 counter redirect to :$DNS_FORWARD_PORT
    }
    {% endif %}

    ######################
    # 以下配置请勿随意修改 #
    ######################

    # chnroute
    {% if (options.useChnRoute): %}
    set chnroute4list {
        type ipv4_addr
        flags interval,timeout
        auto-merge
        timeout 3d
        gc-interval 3d
        {# 空集合只声明，不输出嵌套空 elements。 -#}
        {% if (length(options.ip4.china)): %}
        elements = {
            $IP4_CHNROUTE_LIST
        }
        {% endif %}
    }
    {% endif %}

    {% if (options.useChnRoute): %}
    set chnroute6list {
        type ipv6_addr
        flags interval,timeout
        auto-merge
        timeout 3d
        gc-interval 3d
        {# 空集合只声明，不输出嵌套空 elements。 -#}
        {% if (length(options.ip6.china)): %}
        elements = {
            $IP6_CHNROUTE_LIST
        }
        {% endif %}
    }
    {% endif %}

    # gfwlist
    {% if (options.useGfw): %}
    set gfw4list {
        type ipv4_addr
        flags interval,timeout
        auto-merge
        timeout 3d
        gc-interval 3d
    }
    {% endif %}

    {% if (options.useGfw): %}
    set gfw6list {
        type ipv6_addr
        flags interval,timeout
        auto-merge
        timeout 3d
        gc-interval 3d
    }
    {% endif %}

    # chnlist
    {% if (options.useChn): %}
    set chn4list {
        type ipv4_addr
        flags interval,timeout
        auto-merge
        timeout 3d
        gc-interval 3d
    }
    {% endif %}

    {% if (options.useChn): %}
    set chn6list {
        type ipv6_addr
        flags interval,timeout
        auto-merge
        timeout 3d
        gc-interval 3d
    }
    {% endif %}

    # user custom proxy domain list
    {% if (options.domainSets): %}
    set dnsproxy4list {
        type ipv4_addr
        flags interval,timeout
        auto-merge
        timeout 3d
        gc-interval 3d
    }
    {% endif %}

    {% if (options.domainSets): %}
    set dnsproxy6list {
        type ipv6_addr
        flags interval,timeout
        auto-merge
        timeout 3d
        gc-interval 3d
    }
    {% endif %}

    # user custom direct domain list
    {% if (options.domainSets): %}
    set dnsbypass4list {
        type ipv4_addr
        flags interval,timeout
        auto-merge
        timeout 3d
        gc-interval 3d
    }
    {% endif %}

    {% if (options.domainSets): %}
    set dnsbypass6list {
        type ipv6_addr
        flags interval,timeout
        auto-merge
        timeout 3d
        gc-interval 3d
    }
    {% endif %}

    # user custom proxy ip list
    set bypass4list {
        type ipv4_addr
        flags interval
        auto-merge
        {# 空集合只声明，不输出嵌套空 elements。 -#}
        {% if (length(options.ip4.direct)): %}
        elements = {
            $IP4_DIRECT_NFT_LIST
        }
        {% endif %}
    }

    set proxy4list {
        type ipv4_addr
        flags interval
        auto-merge
        {# 空集合只声明，不输出嵌套空 elements。 -#}
        {% if (length(options.ip4.proxy)): %}
        elements = {
            $IP4_PROXY_NFT_LIST
        }
        {% endif %}
    }

    # user custom direct ip list
    set bypass6list {
        type ipv6_addr
        flags interval
        auto-merge
        {# 空集合只声明，不输出嵌套空 elements。 -#}
        {% if (length(options.ip6.direct)): %}
        elements = {
            $IP6_DIRECT_NFT_LIST
        }
        {% endif %}
    }

    set proxy6list {
        type ipv6_addr
        flags interval
        auto-merge
        {# 空集合只声明，不输出嵌套空 elements。 -#}
        {% if (length(options.ip6.proxy)): %}
        elements = {
            $IP6_PROXY_NFT_LIST
        }
        {% endif %}
    }

    {% if (!options.allowAll): %}
    set proxy_mac_list {
        type ether_addr
        {# 空集合只声明，不输出嵌套空 elements。 -#}
        {% if (length(options.macs)): %}
        elements = {
            $PROXY_MAC
        }
        {% endif %}
    }
    {% endif %}

    {% if (options.allowAll && length(options.excludedMacs)): %}
    set proxy_mac_exclude_list {
        type ether_addr
        {# 空集合只声明，不输出嵌套空 elements。 -#}
        {% if (length(options.excludedMacs)): %}
        elements = {
            $PROXY_MAC_EXCLUDE
        }
        {% endif %}
    }
    {% endif %}

    {% if (!options.allowAll): %}
    set proxy_interface_list {
        type iface_index
        {# 空集合只声明，不输出嵌套空 elements。 -#}
        {% if (length(options.interfaces)): %}
        elements = {
            $PROXY_INTERFACE
        }
        {% endif %}
    }
    {% endif %}

    {% if (options.allowAll && length(options.excludedInterfaces)): %}
    set proxy_interface_exclude_list {
        type iface_index
        {# 空集合只声明，不输出嵌套空 elements。 -#}
        {% if (length(options.excludedInterfaces)): %}
        elements = {
            $PROXY_INTERFACE_EXCLUDE
        }
        {% endif %}
    }
    {% endif %}
}
