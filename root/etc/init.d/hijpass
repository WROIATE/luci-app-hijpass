#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=15
RUNTIME=/usr/lib/hijpass/service/service.sh

# Shell 组织完整服务生命周期；ucode 只生成配置、进程描述和定时任务内容。
. /usr/lib/hijpass/common.sh
. /usr/lib/hijpass/service/procd.sh

start_service() {
    # rc.common 不传播此回调的 return；失败必须退出，避免提交部分实例。
    service_plan="$(hijpass_run_logged service 'Prepare service' "${LINENO:-}" "$RUNTIME" prepare)" || exit 1
    hijpass_run_logged service 'Check core configurations' "${LINENO:-}" hijpass_check_configs "$service_plan" || exit 1
    hijpass_add_instances "$service_plan" || exit 1
    # 禁用服务时，在 procd 提交空实例列表前撤销网络配置。
    if ! hijpass_has_instances "$service_plan"; then
        "$RUNTIME" deactivate || exit 1
    fi
}

service_started() {
    hijpass_has_instances "$service_plan" || return 0
    if hijpass_run_logged service 'Wait for service instances' "${LINENO:-}" hijpass_wait_running hijpass "$service_plan" &&
        "$RUNTIME" activate; then
        return 0
    fi
    # 启动或接管流量失败：撤销本服务网络配置后停止本服务实例。
    stop_service
    procd_kill hijpass
    return 1
}

stop_service() {
    # 撤流失败时退出，阻止 rc.common 继续停止核心，避免流量落到空端口。
    "$RUNTIME" deactivate || exit 1
}

reload_service() {
    /etc/init.d/hijpass restart
}

service_triggers() {
    procd_add_reload_trigger hijpass
    procd_add_interface_trigger "interface.*.up" "*" /etc/init.d/hijpass restart
}

boot() {
    local delay
    delay="$($RUNTIME delay)" || return 1
    [ "$delay" -le 0 ] || sleep "$delay"
    start
}
