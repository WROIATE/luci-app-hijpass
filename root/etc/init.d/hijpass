#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=15
. /usr/lib/hijpass/common.sh
. /usr/lib/hijpass/service/procd.sh

DNS_HOOK=/etc/hijpass/hook/dns-hook.sh

start_service() {
    local plan kind instance keys id name
    plan="$(hijpass_run_logged service 'Prepare configurations' "${LINENO:-}" "$HIJPASS_LIB/service/prepare.sh")" || exit 1
    # 使用独立 JSON 命名空间，避免覆盖 rc.common 正在组装的 procd 消息。
    json_set_namespace hijpass_plan
    json_load "$plan" || { hijpass_log ERROR service "${LINENO:-}" 'Invalid service plan: malformed JSON'; exit 1; }
    json_get_type kind instances
    [ "$kind" = array ] || { hijpass_log ERROR service "${LINENO:-}" 'Invalid service plan: instances must be an array'; exit 1; }
    json_select instances
    json_get_keys keys
    instances=
    for instance in $keys; do
        json_select "$instance" || {
            hijpass_log ERROR service "${LINENO:-}" "Invalid instance entry: index=$instance"
            continue
        }
        json_get_vars id name
        if hijpass_run_logged service "Prepare instance $id ($name)" "${LINENO:-}" hijpass_add_instance; then
            instances="$instances $instance"
        fi
        json_select ..
    done
}

service_started() {
    local failed=0
    # procd 已收到实例描述；按顺序设置辅助功能，不轮询进程状态。
    [ -n "$instances" ] || return 0
    hijpass_run_logged route 'Reset policy routes' "${LINENO:-}" "$HIJPASS_LIB/firewall/route.sh" reset || failed=1
    "$HIJPASS_LIB/firewall/firewall.sh" reset || failed=1
    hijpass_run_logged service 'DNS Hook start' "${LINENO:-}" "$DNS_HOOK" start || failed=1
    update_cron enable || failed=1
    if [ "$failed" -ne 0 ]; then
        hijpass_log ERROR service "${LINENO:-}" 'Service setup completed with errors'
        return 1
    fi
    hijpass_log INFO service "${LINENO:-}" 'Service started'
}

stop_service() {
    local failed=0
    hijpass_run_logged service 'DNS Hook stop' "${LINENO:-}" "$DNS_HOOK" stop || failed=1
    # 按撤流、路由、cron 的顺序尝试清理；失败不阻断其他步骤或框架停实例。
    "$HIJPASS_LIB/firewall/firewall.sh" remove || failed=1
    hijpass_run_logged route 'Remove policy routes' "${LINENO:-}" "$HIJPASS_LIB/firewall/route.sh" remove || failed=1
    update_cron disable || failed=1
    if [ "$failed" -ne 0 ]; then
        hijpass_log ERROR service "${LINENO:-}" 'Service cleanup completed with errors'
        return 1
    fi
    hijpass_log INFO service "${LINENO:-}" 'Service resources removed'
}

update_cron() {
    hijpass_run_logged service 'Write cron entries' "${LINENO:-}" "$HIJPASS_LIB/service/prepare.sh" cron "$1" || return 1
    hijpass_run_logged service 'Cron reload' "${LINENO:-}" /etc/init.d/cron restart
}

reload_service() {
    /etc/init.d/hijpass restart
}

service_triggers() {
    procd_add_reload_trigger hijpass
    procd_add_interface_trigger "interface.*.up" "*" /etc/init.d/hijpass restart
}

boot() {
    local delay
    delay=$(uci -q get 'hijpass.@hijpass[0].delay_time') || {
        # 字段未配置采用 0；配置文件本身不可读时终止启动。
        hijpass_run_logged service 'Read startup configuration' "${LINENO:-}" uci export hijpass >/dev/null || return $?
        delay=0
    }
    delay=${delay:-0}
    [ "$delay" -ge 0 ] 2>/dev/null || { hijpass_log ERROR service "${LINENO:-}" 'Invalid startup delay'; return 1; }
    [ "$delay" -le 0 ] || hijpass_run_logged service 'Startup delay' "${LINENO:-}" sleep "$delay" || return $?
    start
}
