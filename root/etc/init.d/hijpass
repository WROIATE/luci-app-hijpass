#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=15
RUNTIME=/usr/lib/hijpass/service.uc

# 此层只桥接 rc.common/procd。UCI 解析、配置文件、DNS、防火墙和定时任务由 ucode 完成。
. /usr/lib/hijpass/procd.sh

start_service() {
    local plan
    plan="$($RUNTIME prepare)" || return 1
    hijpass_start_instances "$plan" || return 1
    $RUNTIME activate
}

stop_service() {
    $RUNTIME deactivate
}

reload_service() {
    /etc/init.d/hijpass restart
}

service_triggers() {
    procd_add_reload_trigger hijpass
    procd_add_interface_trigger "interface.*.up" "*" /etc/init.d/hijpass restart
}

boot() {
    local delay
    delay="$($RUNTIME delay)" || return 1
    [ "$delay" -le 0 ] || sleep "$delay"
    start
}
