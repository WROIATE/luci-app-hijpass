#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=15
. /usr/lib/hijpass/common.sh
. /usr/lib/hijpass/service/procd.sh

DNS_HOOK=/etc/hijpass/hook/dns-hook.sh

start_service() {
    local plan kind instance
    plan="$(hijpass_run_logged service 'Prepare configurations' "${LINENO:-}" "$HIJPASS_LIB/service/prepare.sh")" || exit 1
    # 使用独立 JSON 命名空间，避免覆盖 rc.common 正在组装的 procd 消息。
    json_set_namespace hijpass_plan
    json_load "$plan" || exit 1
    json_get_type kind instances
    [ "$kind" = array ] || { echo 'Invalid service plan: instances must be an array' >&2; exit 1; }
    json_select instances
    json_get_keys instances
    # 空实例也是正常配置；撤销旧辅助功能后由框架提交空列表。
    if [ -z "$instances" ]; then
        stop_service
        return 0
    fi
    for instance in $instances; do
        json_select "$instance" || exit 1
        hijpass_add_instance || exit 1
        json_select ..
    done
}

service_started() {
    # procd 已收到实例描述；按约定直接设置辅助功能，不轮询进程状态。
    [ -n "$instances" ] || return 0
    if hijpass_run_logged route 'Reset policy routes' "${LINENO:-}" "$HIJPASS_LIB/firewall/route.sh" reset &&
        "$HIJPASS_LIB/firewall/firewall.sh" reset &&
        hijpass_run_logged service 'DNS Hook start' "${LINENO:-}" "$DNS_HOOK" start &&
        update_cron enable; then
        hijpass_log INFO service "${LINENO:-}" 'Service started'
        return 0
    fi
    hijpass_log ERROR service "${LINENO:-}" 'Service setup failed'
    stop
    return 1
}

stop_service() {
    local failed=0
    hijpass_run_logged service 'DNS Hook stop' "${LINENO:-}" "$DNS_HOOK" stop || failed=1
    # 先撤销流量接管，再移除路由；撤流失败时阻止框架继续停核心。
    "$HIJPASS_LIB/firewall/firewall.sh" remove || exit 1
    hijpass_run_logged route 'Remove policy routes' "${LINENO:-}" "$HIJPASS_LIB/firewall/route.sh" remove || failed=1
    [ "$failed" -eq 0 ] || exit 1
    update_cron disable || hijpass_log WARN service "${LINENO:-}" 'Cron cleanup failed; continuing service stop'
    hijpass_log INFO service "${LINENO:-}" 'Service resources removed'
}

update_cron() {
    hijpass_run_logged service 'Write cron entries' "${LINENO:-}" "$HIJPASS_LIB/service/prepare.sh" cron "$1" || return 1
    hijpass_run_logged service 'Cron reload' "${LINENO:-}" /etc/init.d/cron restart
}

reload_service() {
    /etc/init.d/hijpass restart
}

service_triggers() {
    procd_add_reload_trigger hijpass
    procd_add_interface_trigger "interface.*.up" "*" /etc/init.d/hijpass restart
}

boot() {
    local delay
    delay="$(hijpass_run_logged service 'Read startup delay' "${LINENO:-}" "$HIJPASS_LIB/service/prepare.sh" delay)" || return 1
    [ "$delay" -le 0 ] || sleep "$delay"
    start
}
