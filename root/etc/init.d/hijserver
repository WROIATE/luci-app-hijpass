#!/bin/sh /etc/rc.common

START=99
STOP=15
# 保留 rc.common 命令入口，生命周期显式检查每个阶段与 procd 的返回值。
. /usr/lib/hijpass/service/lifecycle.sh

service_triggers() {
    procd_add_reload_trigger hijserver
    procd_add_interface_trigger "interface.*.up" "*" /etc/init.d/hijserver restart
}

boot() {
    sleep 10
    start
}
