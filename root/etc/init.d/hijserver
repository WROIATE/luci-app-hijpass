#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=15
RUNTIME=/usr/lib/hijpass/service.uc
. /usr/lib/hijpass/procd.sh

# 服务端复用同一份进程描述；命令解析、端口校验、防火墙和日志计划在 ucode 中。
start_service() {
    local plan
    plan="$($RUNTIME server prepare)" || return 1
    hijpass_start_instances "$plan" || return 1
    $RUNTIME server activate
}

stop_service() {
    $RUNTIME server deactivate
}

reload_service() {
    /etc/init.d/hijserver restart
}

service_triggers() {
    procd_add_reload_trigger hijserver
    procd_add_interface_trigger "interface.*.up" "*" /etc/init.d/hijserver restart
}

boot() {
    sleep 10
    start
}
