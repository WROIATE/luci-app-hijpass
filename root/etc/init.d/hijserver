#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=15
. /usr/lib/hijpass/common.sh
. /usr/lib/hijpass/service/procd.sh

NFT_TABLE='/usr/share/nftables.d/table-post/hijserver.nft'
NFT_CHAIN='/usr/share/nftables.d/chain-pre/input_wan/hijserver.nft'

start_service() {
    local plan kind instance keys id name log
    hijpass_log INFO server "${LINENO:-}" 'Starting hijserver...'
    plan="$(hijpass_run_logged server 'Prepare configurations' "${LINENO:-}" "$HIJPASS_LIB/service/prepare.sh" server)" || exit 1
    # 使用独立 JSON 命名空间，避免覆盖 rc.common 正在组装的 procd 消息。
    json_set_namespace hijserver_plan
    json_load "$plan" || { hijpass_log ERROR server "${LINENO:-}" 'Invalid service plan: malformed JSON'; exit 1; }
    json_get_type kind instances
    [ "$kind" = array ] || { hijpass_log ERROR server "${LINENO:-}" 'Invalid service plan: instances must be an array'; exit 1; }
    json_select instances
    json_get_keys keys
    instances=
    cron_log=0
    for instance in $keys; do
        json_select "$instance" || {
            hijpass_log ERROR server "${LINENO:-}" "Invalid instance entry: index=$instance"
            continue
        }
        json_get_vars id name log
        [ -z "$log" ] || cron_log=1
        if hijpass_run_logged server "Prepare instance $id ($name)" "${LINENO:-}" hijpass_add_instance; then
            instances="$instances $instance"
        fi
        json_select ..
    done
}

service_started() {
    # procd 已收到实例描述；按顺序设置辅助功能，不轮询进程状态。
    [ -n "$instances" ] || return 0
    # 规则写入失败不 reload；其他独立阶段仍继续执行。
    if hijpass_run_logged server 'Write firewall rules' "${LINENO:-}" "$HIJPASS_LIB/service/prepare.sh" server server-files "$NFT_TABLE" "$NFT_CHAIN"; then
        hijpass_run_logged server 'Firewall reload' "${LINENO:-}" fw4 reload
    fi
    update_cron enable
}

stop_service() {
    hijpass_log INFO server "${LINENO:-}" 'Stopping hijserver...'
    # 文件删除失败不 reload，但仍清理 cron 并交回框架停实例。
    if hijpass_run_logged server 'Remove firewall rules' "${LINENO:-}" rm -f "$NFT_TABLE" "$NFT_CHAIN"; then
        hijpass_run_logged server 'Firewall reload' "${LINENO:-}" fw4 reload
    fi
    update_cron disable
}

update_cron() {
    local logs=0
    hijpass_log INFO server "${LINENO:-}" "Updating cron entries ($1)"
    [ "$1" != enable ] || logs=${cron_log:-0}
    hijpass_run_logged server 'Write cron entries' "${LINENO:-}" hijpass_run_ucode "$HIJPASS_LIB/service/cron.uc" hijserver '' "$logs" || return 1
    hijpass_log INFO server "${LINENO:-}" 'Reloading cron'
    hijpass_run_logged server 'Cron reload' "${LINENO:-}" /etc/init.d/cron restart
}

reload_service() {
    /etc/init.d/hijserver restart
}

service_triggers() {
    procd_add_reload_trigger hijserver
    procd_add_interface_trigger "interface.*.up" "*" /etc/init.d/hijserver restart
}

boot() {
    hijpass_run_logged server 'Startup delay' "${LINENO:-}" sleep 10 || return $?
    start
}
