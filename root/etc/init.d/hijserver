#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=15
. /usr/lib/hijpass/common.sh
. /usr/lib/hijpass/service/procd.sh

NFT_TABLE=/usr/share/nftables.d/table-post/hijserver.nft
NFT_CHAIN=/usr/share/nftables.d/chain-pre/input_wan/hijserver.nft

start_service() {
    local plan kind instance
    plan="$(hijpass_run_logged server 'Prepare configurations' "${LINENO:-}" "$HIJPASS_LIB/service/prepare.sh" server)" || exit 1
    # 使用独立 JSON 命名空间，避免覆盖 rc.common 正在组装的 procd 消息。
    json_set_namespace hijserver_plan
    json_load "$plan" || exit 1
    json_get_type kind instances
    [ "$kind" = array ] || { echo 'Invalid service plan: instances must be an array' >&2; exit 1; }
    json_select instances
    json_get_keys instances
    # 空实例也是正常配置；撤销旧辅助功能后由框架提交空列表。
    if [ -z "$instances" ]; then
        stop_service
        return 0
    fi
    for instance in $instances; do
        json_select "$instance" || exit 1
        hijpass_add_instance || exit 1
        json_select ..
    done
}

service_started() {
    # procd 已收到实例描述；按约定直接设置辅助功能，不轮询进程状态。
    [ -n "$instances" ] || return 0
    if hijpass_run_logged server 'Write firewall rules' "${LINENO:-}" "$HIJPASS_LIB/service/prepare.sh" server server-files &&
        hijpass_run_logged server 'Firewall reload' "${LINENO:-}" fw4 reload &&
        update_cron enable; then
        hijpass_log INFO server "${LINENO:-}" 'Service started'
        return 0
    fi
    hijpass_log ERROR server "${LINENO:-}" 'Service setup failed'
    stop
    return 1
}

stop_service() {
    rm -f "$NFT_TABLE" "$NFT_CHAIN" || exit 1
    hijpass_run_logged server 'Firewall reload' "${LINENO:-}" fw4 reload || exit 1
    update_cron disable || hijpass_log WARN server "${LINENO:-}" 'Cron cleanup failed; continuing service stop'
    hijpass_log INFO server "${LINENO:-}" 'Service resources removed'
}

update_cron() {
    hijpass_run_logged server 'Write cron entries' "${LINENO:-}" "$HIJPASS_LIB/service/prepare.sh" server cron "$1" || return 1
    hijpass_run_logged server 'Cron reload' "${LINENO:-}" /etc/init.d/cron restart
}

reload_service() {
    /etc/init.d/hijserver restart
}

service_triggers() {
    procd_add_reload_trigger hijserver
    procd_add_interface_trigger "interface.*.up" "*" /etc/init.d/hijserver restart
}

boot() {
    sleep 10
    start
}
