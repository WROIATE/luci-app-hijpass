#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=15
RUNTIME=/usr/lib/hijpass/service/server.sh
. /usr/lib/hijpass/common.sh
. /usr/lib/hijpass/service/procd.sh

# 服务端的数据准备使用 ucode，进程、防火墙应用和服务启停由 Shell 组织。
start_service() {
    # rc.common 不传播此回调的 return；失败必须退出，避免提交部分实例。
    service_plan="$(hijpass_run_logged server 'Prepare service' "${LINENO:-}" "$RUNTIME" prepare)" || exit 1
    hijpass_run_logged server 'Check core configurations' "${LINENO:-}" hijpass_check_configs "$service_plan" || exit 1
    # 提交前清理旧辅助配置，直接 start 更新已有实例时也遵守这个顺序。
    stop_service
    # 合法空列表由框架直接提交，保留配置变更触发器。
    hijpass_has_instances "$service_plan" || return 0
    hijpass_add_instances "$service_plan" || exit 1
}

service_started() {
    # 此回调在实例提交后执行，不代表核心已经就绪。
    hijpass_has_instances "$service_plan" || return 0
    "$RUNTIME" setup_aux && return 0
    # 辅助配置失败：先撤流，再由原生 stop 停止本服务。
    stop
    return 1
}

stop_service() {
    # 撤流失败时退出，阻止 rc.common 继续停止核心，避免流量落到空端口。
    "$RUNTIME" clear_aux || exit 1
}

reload_service() {
    /etc/init.d/hijserver restart
}

service_triggers() {
    procd_add_reload_trigger hijserver
    procd_add_interface_trigger "interface.*.up" "*" /etc/init.d/hijserver restart
}

boot() {
    sleep 10
    start
}
