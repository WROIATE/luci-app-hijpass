import * as fs from 'fs';
import { lines } from 'hijpass.common';

// Capture：mode/client/protocol/port/seconds/url/method/host/targetPort/addresses，
// verbose/tcpdump/iface/chain/comment 为捕获设置；所有日志位于独立任务目录。
// LogPosition：path/offset/inode，用字节位置读取本次新增日志，兼容日志轮转。
/**
 * 从记录的偏移开始读取日志，最多读取 4 MiB。
 * @param {string} path
 * @param {integer} [offset]
 * @returns {string} 日志文本；打开或定位失败时为空字符串。
 */
function tail(path, offset) {
	let file = fs.open(path, 'r');
	if (!file) return '';
	// 检查已打开的文件，避免日志轮转使路径消失或指向另一份日志。
	let limit = 4 * 1024 * 1024;
	if (!file.seek(0, 2)) { file.close(); return ''; }
	let size = file.tell();
	if (size == null || !file.seek(max(offset || 0, size - limit))) { file.close(); return ''; }
	// 日志可能仍在增长，读取长度也要限制，不能只限制起始位置。
	let data = file.read(limit) || '';
	file.close();
	return data;
}
/**
 * 按 trace ID 收集经过指定链的完整追踪记录。
 * @param {string} text
 * @param {string} chain
 * @returns {string[]} 关联日志行数组，包含这些 trace ID 在其他链中的记录。
 */
export function filteredTrace(text, chain) {
	let entries = lines(text), ids = {};
	for (let line in entries) {
		let m = match(line, /^trace id ([^ ]+) inet hijpass ([^ ]+) (rule|unknown rule)/);
		if (m && m[2] == chain) ids[m[1]] = true;
	}
	return filter(entries, line => {
		let m = match(line, /^trace id ([^ ]+)/);
		return m && ids[m[1]];
	});
};
/**
 * 将文本行去重、截断，并统一添加缩进。
 * @param {string[]} values
 * @param {integer} limit
 * @param {string} [spaces]
 * @returns {string} 多行文本；默认每行缩进两个空格。
 */
function indent(values, limit, spaces) { return join('\n', map(slice(uniq(values), 0, limit), line => (spaces || '  ') + line)); }
/**
 * 统计抓包中的协议、TCP 状态和流量分布。
 * @param {string[]} packets
 * @returns {object} {counts, interfaces, flows}，分别为包统计、接口统计和连接统计。
 */
export function packetSummary(packets) {
	let counts = { syn: 0, syn_ack: 0, fin: 0, rst: 0, udp: 0, payload_packets: 0, payload_bytes: 0 }, interfaces = {}, flows = {};
	for (let line in packets) {
		let fields = split(trim(line), /[ \t]+/), iface = fields[1], direction = fields[2], source = fields[4], destination = fields[6];
		if (fields[3] != 'IP' && fields[3] != 'IP6') { iface = '-'; direction = '-'; source = fields[2]; destination = fields[4]; }
		let key = `${iface}/${direction}`, flow = `${source} -> ${replace(destination || '', /:$/, '')}`;
		interfaces[key] = (interfaces[key] || 0) + 1;
		flows[flow] = (flows[flow] || 0) + 1;
		if (match(line, /Flags \[S\]/)) counts.syn++;
		if (match(line, /Flags \[S[.]\]/)) counts.syn_ack++;
		if (match(line, /Flags \[F/)) counts.fin++;
		if (match(line, /Flags \[R/)) counts.rst++;
		if (index(line, ' UDP,') >= 0) counts.udp++;
		let lengthMatch = match(line, /length ([0-9]+)/);
		if (index(line, 'Flags ') >= 0 && lengthMatch && int(lengthMatch[1]) > 0) { counts.payload_packets++; counts.payload_bytes += int(lengthMatch[1]); }
	}
	return { counts, interfaces, flows };
};
/**
 * 按目标地址和连接 ID 筛选相关核心日志。
 * @param {string} text
 * @param {array} targets 可含缺失地址；匹配前过滤空值。
 * @returns {string[]} 去重后的日志行数组，最多 100 行。
 */
function relatedLogs(text, targets) {
	let all = lines(text), seeds = slice(uniq(filter(all, line => length(filter(targets, target => target && index(line, target) >= 0)))), 0, 80), ids = [];
	for (let line in seeds) {
		let m;
		while ((m = match(line, /\[([0-9]+)\]/))) {
			push(ids, m[0]); line = substr(line, index(line, m[0]) + length(m[0]));
		}
	}
	return slice(uniq([...seeds, ...filter(all, line => length(filter(ids, id => index(line, id) >= 0)))]), 0, 100);
}
/**
 * @typedef {object} Capture
 * @property {string} mode client 或 router，决定报告布局。
 * @property {string|null} client 客户端 IP，client 模式使用。
 * @property {string} protocol all/tcp/udp，client 模式的网络过滤。
 * @property {string} port 目标端口或 all。
 * @property {integer} seconds 捕获时长，秒。
 * @property {string|null} url router 模式的请求 URL。
 * @property {string|null} method HEAD/GET，router 模式使用。
 * @property {string|null} host router 模式的目标域名或 IP。
 * @property {integer|null} targetPort router 模式的目标端口。
 * @property {string[]} addresses 解析后的目标 IP，空数组表示没有解析结果。
 * @property {boolean|null} verbose 是否输出原始日志。
 * @property {boolean|null} tcpdump 是否包含抓包报告。
 * @property {string|null} iface tcpdump 接口。
 * @property {string|null} filter tcpdump BPF 过滤表达式。
 * @property {string} chain 任务专属 nft 链名。
 * @property {string} comment 任务专属 nft 注释，用于区分规则。
 */
/**
 * 汇总防火墙追踪、抓包和日志，生成诊断报告。
 * @param {Capture} c
 * @param {string} directory
 * @param {object[]} [positions]
 * @returns {string} 完整报告文本，以换行结束。
 */
export function report(c, directory, positions) {
	let output = ['\n== Trace summary =='];
	let curl = {};
	for (let line in lines(fs.readfile(directory + '/curl.out'))) { let eq = index(line, '='); if (eq >= 0) curl[substr(line, 0, eq)] = substr(line, eq + 1); }
	if (c.mode == 'client') push(output, `mode: client prerouting (before NAT), client=${c.client}`,
		`capture: duration=${c.seconds}s protocol=${c.protocol} destination_port=${c.port}`, 'requests: generated by the client; no URL or HTTP method filter');
	else push(output, 'mode: router out-route', `request: ${c.method} ${c.url}`,
		`target: ${c.host}:${c.targetPort} (${join(', ', c.addresses) || 'unavailable'})`,
		`curl: exit=${trim(fs.readfile(directory + '/curl.exit') || '?')} http=${curl.http_code || '-'} remote=${curl.remote_ip || '-'}:${curl.remote_port || '-'} total=${curl.time_total || '-'}s`);
	let curlErrors = lines(fs.readfile(directory + '/curl.err'));
	if (length(curlErrors)) push(output, 'curl_error:', indent(curlErrors, 4));
	push(output, '\n== Firewall ==');
	let setup = lines(fs.readfile(directory + '/nft.setup'));
	if (length(setup)) push(output, 'setup_warnings:', indent(setup, 20));
	let text = tail(directory + '/nft.trace'), trace = c.mode == 'client' ? filteredTrace(text, c.chain) : lines(text);
	push(output, `captured: ${length(trace)} nft trace lines`);
	if (!length(trace)) push(output, 'decision: no nft trace captured', 'check: matching traffic must pass table inet hijpass during capture');
	else {
		let joined = join('\n', trace), verdict = 'unknown from captured trace';
		if (match(joined, / reject/)) verdict = 'rejected by proxy-port-filter or another firewall rule';
		else if (match(joined, /tproxy to :/)) verdict = 'transparent proxy interception observed';
		else if (match(joined, /ct mark set 0/)) verdict = 'bypassed by proxy-port-filter or direct rule';
		else if (match(joined, /comment "shunt mark"/)) verdict = 'marked for shunt, but final tproxy was not observed';
		push(output, 'decision: ' + verdict);
		if (c.mode == 'client') {
			let tuples = {};
			for (let line in trace) {
				let m = match(line, /^trace id ([^ ]+) inet hijpass ([^ ]+) packet: (.*)$/);
				if (!m || m[2] != c.chain) continue;
				// nft 同时打印 ether saddr/daddr；五元组必须读取 IP 层地址，不能取第一个 saddr。
				let packet = m[3], source = match(packet, /ip6? saddr ([^ ]+)/), destination = match(packet, /ip6? daddr ([^ ]+)/);
				if (!source || !destination) continue;
				let sport = match(packet, /(tcp|udp) sport ([0-9]+)/), dport = match(packet, /dport ([0-9]+)/);
				let tuple = `${sport ? sport[1] : 'IP'} [${source[1]}]:${sport ? sport[2] : '-'} -> [${destination[1]}]:${dport ? dport[1] : '-'}`;
				if (!tuples[tuple]) tuples[tuple] = `  trace=${m[1]} ${tuple}`;
			}
			if (length(tuples)) push(output, 'client_flows (first 40 unique tuples):', join('\n', slice(values(tuples), 0, 40)));
			push(output, `client_flows_total: ${length(tuples)}`);
		}
		let chains = [], steps = [];
		for (let line in trace) {
			let m = match(line, /inet hijpass ([^ ]+)/);
			if (m) push(chains, m[1]);
			if (index(line, c.comment) >= 0 || !match(line, / rule /) || !match(line, /jump|return|tproxy|reject|accept|drop|ct mark set|meta mark set/)) continue;
			line = replace(line, /^.*inet hijpass /, '');
			line = replace(line, / counter( packets [0-9]+ bytes [0-9]+)?/g, '');
			line = replace(line, / \(verdict.*$/, '');
			push(steps, substr(line, 0, 180));
		}
		push(output, 'path: ' + join(' -> ', uniq(chains)), 'key_rules:', length(steps) ? indent(steps, 14) : '  none');
		if (c.verbose) push(output, 'raw_trace_tail:', indent(slice(trace, -80), 80));
	}
	if (c.tcpdump) {
		push(output, '\n== Packet capture ==', `interface: ${c.iface}`, `filter: ${c.filter}`);
		let packets = lines(tail(directory + '/tcpdump.log'));
		let targets = [...c.addresses, curl.remote_ip];
		let related = c.mode == 'client' ? packets : slice(uniq(filter(packets, line => length(filter(targets, ip => ip && index(line, ip) >= 0)))), 0, 200);
		push(output, `captured: total=${length(packets)} related=${length(related)} other_same_port=${length(packets) - length(related)}`);
		if (length(related)) {
			let summary = packetSummary(related), counts = summary.counts;
			push(output, 'target_summary:', `  tcp: syn=${counts.syn} syn_ack=${counts.syn_ack} fin=${counts.fin} rst=${counts.rst} payload_packets=${counts.payload_packets} payload_bytes=${counts.payload_bytes}`,
				`  udp: packets=${counts.udp}`, '  interfaces:', join('\n', map(keys(summary.interfaces), key => `    - ${key} packets=${summary.interfaces[key]}`)),
				'  flows:', join('\n', map(slice(keys(summary.flows), 0, 6), key => `    - ${key} packets=${summary.flows[key]}`)));
		}
		else push(output, 'related_packets: none');
		let errors = filter(lines(fs.readfile(directory + '/tcpdump.err')), line => !match(line, /listening on|verbose output suppressed|packets captured|packets received|packets dropped|promiscuous/i));
		if (length(errors)) push(output, 'tcpdump_warnings:', indent(errors, 6));
		if (c.verbose) push(output, 'raw_packet_tail:', indent(slice(packets, -80), 80));
	}
	push(output, '\n== Core logs ==');
	let service = '';
	for (let entry in positions || []) {
		let stat = fs.stat(entry.path);
		if (!stat) continue;
		let offset = stat.inode == entry.inode && stat.size >= entry.offset ? entry.offset : 0;
		service += tail(entry.path, offset) + '\n';
	}
	let printed = false;
	for (let label, text in { service, system: tail(directory + '/system.log') }) {
		let related = relatedLogs(text, [c.client, c.host, ...c.addresses, curl.remote_ip]);
		if (!length(related)) continue;
		printed = true;
		push(output, label + ':');
		let issues = filter(related, line => match(line, /error|failed|timeout|warn/i));
		let dns = filter(related, line => match(line, /dns|lookup|resolve|query|answer|reply|cache/i) && !match(line, /error|failed|timeout|warn/i));
		let flows = filter(related, line => match(line, /inbound|outbound|routing|route|detour|accepted|connection|tproxy|mark/i) && !match(line, /error|failed|timeout|warn|dns|lookup|resolve|query|answer|reply|cache/i));
		for (let group, values in { issues, dns, flow: flows }) if (length(values)) push(output, `  ${group}:`, indent(values, group == 'issues' ? 8 : 12, '    '));
		if (!length(issues) && !length(dns) && !length(flows)) push(output, '  matched:', indent(related, 8, '    '));
		if (c.verbose) push(output, '  raw_related:', indent(related, 100, '    '));
	}
	if (!printed) push(output, 'no related core/system log lines captured', 'hint: enable proxy/shunt logs or raise core log level for more detail');
	return join('\n', output) + '\n';
};
