{%
/**
 * @typedef {object} AddressLists
 * @property {string[]} direct 绕过代理的地址。
 * @property {string[]} proxy 强制代理的地址。
 * @property {string[]} china 国内路由地址。
 */
/**
 * @typedef {object} RuleOptions
 * @property {boolean} domainSets 是否启用自定义 DNS 域名集合。
 * @property {AddressLists} ip4 IPv4 地址列表。
 * @property {AddressLists} ip6 IPv6 地址列表。
 * @property {boolean} useChn 是否启用国内域名集合。
 * @property {boolean} useChnRoute 是否启用国内路由绕过。
 * @property {boolean} useGfw 是否启用代理域名集合。
 */
/** @global {RuleOptions} options 由 generate.uc 注入的已校验字段。 */
%}
{# 集合声明属于内部结构；动态 DNS 集合保留，空静态列表不生成集合。 -#}
{% for (let version in [4, 6]): %}
{% let addresses = version == 4 ? options.ip4 : options.ip6; %}
{# Chinadns 会持续填充这些集合，因此即使没有初始地址也保留声明。 -#}
{% for (let set in [
    { name: 'chnroute', enabled: options.useChnRoute, elements: addresses.china },
    { name: 'gfw', enabled: options.useGfw, elements: [] },
    { name: 'chn', enabled: options.useChn, elements: [] },
    { name: 'dnsproxy', enabled: options.domainSets, elements: [] },
    { name: 'dnsbypass', enabled: options.domainSets, elements: [] },
]): %}
{% if (set.enabled): %}
    set {{ set.name }}{{ version }}list {
        type ipv{{ version }}_addr
        flags interval,timeout
        auto-merge
        timeout 3d
        gc-interval 3d
{% if (length(set.elements)): %}
        elements = { {{ join(', ', set.elements) }} }
{% endif %}
    }
{% endif %}
{% endfor %}
{# 静态地址只供规则匹配；列表为空时连同匹配规则一起省略。 -#}
{% for (let set in [
    { name: 'bypass', elements: addresses.direct },
    { name: 'proxy', elements: addresses.proxy },
]): %}
{% if (length(set.elements)): %}
    set {{ set.name }}{{ version }}list {
        type ipv{{ version }}_addr
        flags interval
        auto-merge
        elements = { {{ join(', ', set.elements) }} }
    }
{% endif %}
{% endfor %}
{% endfor %}
