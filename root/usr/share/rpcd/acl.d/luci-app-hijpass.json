{
  "luci-app-hijpass": {
    "description": "Grant access to hijpass configurations",
    "read": {
      "cgi-io": [
        "exec"
      ],
      "uci": [
        "hijpass",
        "hijserver",
        "dhcp"
      ],
      "file": {
        "/etc/hijpass/*": [
          "read"
        ],
        "/tmp/hijpass/log/*.log": [
          "read"
        ],
        "/tmp/hijserver/log/*.log": [
          "read"
        ]
      },
      "ubus": {
        "service": [
          "list"
        ]
      }
    },
    "write": {
      "uci": [
        "hijpass",
        "hijserver"
      ],
      "file": {
        "/etc/hijpass/*": [
          "write"
        ],
        "/tmp/hijpass/log/*.log": [
          "write"
        ],
        "/tmp/hijserver/log/*.log": [
          "write"
        ],
        "/etc/init.d/hijpass restart": [
          "exec"
        ],
        "/usr/lib/hijpass/nft.uc reset": [
          "exec"
        ],
        "/usr/lib/hijpass/nft.uc show": [
          "exec"
        ],
        "/usr/bin/tail -n [0-9]* /tmp/hijpass/log/*.log": [
          "exec"
        ],
        "/usr/bin/tail -n [0-9]* /tmp/hijserver/log/*.log": [
          "exec"
        ],
        "/usr/lib/hijpass/rules.uc update": [
          "exec"
        ],
        "/usr/lib/hijpass/rules.uc query [A-Za-z0-9._:/-]*": [
          "exec"
        ],
        "/usr/lib/hijpass/iptype.uc [A-Za-z0-9._:/-]*": [
          "exec"
        ],
        "/usr/lib/hijpass/connect.uc https://www.baidu.com [0-9]*": [
          "exec"
        ],
        "/usr/lib/hijpass/connect.uc https://www.google.com/ncr [0-9]*": [
          "exec"
        ],
        "/usr/lib/hijpass/connect.uc https://github.com [0-9]*": [
          "exec"
        ],
        "/usr/lib/hijpass/connect.uc https://www.bilibili.com [0-9]*": [
          "exec"
        ],
        "/usr/lib/hijpass/net.uc port [0-9]*": [
          "exec"
        ],
        "/usr/lib/hijpass/net.uc ping [0-9]*": [
          "exec"
        ],
        "/usr/lib/hijpass/geoview.uc -e geosite [A-Za-z0-9_.:,/!-]*": [
          "exec"
        ],
        "/usr/lib/hijpass/geoview.uc -e geoip [A-Za-z0-9_.:,/!-]*": [
          "exec"
        ],
        "/usr/lib/hijpass/geoview.uc -l geosite [A-Za-z0-9._:/-]*": [
          "exec"
        ],
        "/usr/lib/hijpass/geoview.uc -l geoip [A-Za-z0-9._:/-]*": [
          "exec"
        ],
        "/usr/lib/hijpass/route-match.uc [A-Za-z0-9._:/-]*": [
          "exec"
        ],
        "/usr/lib/hijpass/rm.uc proxy [A-Za-z0-9_-]*": [
          "exec"
        ],
        "/usr/lib/hijpass/rm.uc proxy [A-Za-z0-9_-]* /etc/hijpass/client/*": [
          "exec"
        ],
        "/usr/lib/hijpass/rm.uc server [A-Za-z0-9_-]*": [
          "exec"
        ],
        "/usr/lib/hijpass/rm.uc server [A-Za-z0-9_-]* /etc/hijpass/server/*": [
          "exec"
        ],
        "/bin/cat /proc/net/arp": [
          "exec"
        ],
        "/usr/lib/hijpass/core-update.uc version sing-box": [
          "exec"
        ],
        "/usr/lib/hijpass/core-update.uc version xray": [
          "exec"
        ],
        "/usr/lib/hijpass/core-update.uc latest sing-box": [
          "exec"
        ],
        "/usr/lib/hijpass/core-update.uc latest xray": [
          "exec"
        ],
        "/usr/lib/hijpass/core-update.uc update sing-box": [
          "exec"
        ],
        "/usr/lib/hijpass/core-update.uc update xray": [
          "exec"
        ],
        "/usr/lib/hijpass/trace-task.uc start -t [0-9]* -X [A-Z]* [A-Za-z0-9._:/?&=%#~+\\[\\]-]*": [
          "exec"
        ],
        "/usr/lib/hijpass/trace-task.uc start -t [0-9]* -X [A-Z]* -v [A-Za-z0-9._:/?&=%#~+\\[\\]-]*": [
          "exec"
        ],
        "/usr/lib/hijpass/trace-task.uc start -t [0-9]* -X [A-Z]* -p -i [A-Za-z0-9_.:@-]* [A-Za-z0-9._:/?&=%#~+\\[\\]-]*": [
          "exec"
        ],
        "/usr/lib/hijpass/trace-task.uc start -t [0-9]* -X [A-Z]* -p -i [A-Za-z0-9_.:@-]* -v [A-Za-z0-9._:/?&=%#~+\\[\\]-]*": [
          "exec"
        ],
        "/usr/lib/hijpass/trace-task.uc start -t [0-9]* -c [A-Fa-f0-9:.]* -n [a-z]* -P [a-z0-9]*": [
          "exec"
        ],
        "/usr/lib/hijpass/trace-task.uc start -t [0-9]* -c [A-Fa-f0-9:.]* -n [a-z]* -P [a-z0-9]* -v": [
          "exec"
        ],
        "/usr/lib/hijpass/trace-task.uc start -t [0-9]* -c [A-Fa-f0-9:.]* -n [a-z]* -P [a-z0-9]* -p -i [A-Za-z0-9_.:@-]*": [
          "exec"
        ],
        "/usr/lib/hijpass/trace-task.uc start -t [0-9]* -c [A-Fa-f0-9:.]* -n [a-z]* -P [a-z0-9]* -p -i [A-Za-z0-9_.:@-]* -v": [
          "exec"
        ],
        "/usr/lib/hijpass/trace-task.uc status [A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9]": [
          "exec"
        ],
        "/usr/lib/hijpass/trace-task.uc release [A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9]": [
          "exec"
        ]
      },
      "ubus": {
        "hijpass-config": [
          "render",
          "validate"
        ]
      }
    }
  }
}
