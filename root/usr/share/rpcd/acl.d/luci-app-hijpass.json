{
  "luci-app-hijpass": {
    "description": "Grant access to hijpass configurations",
    "read": {
      "uci": [
        "hijpass",
        "hijserver"
      ],
      "file": {
        "/etc/hijpass/*": [
          "read"
        ],
        "/tmp/hijpass/log/*.log": [
          "read"
        ],
        "/tmp/hijserver/log/*.log": [
          "read"
        ]
      },
      "ubus": {
        "service": [
          "list"
        ]
      }
    },
    "write": {
      "uci": [
        "hijpass",
        "hijserver"
      ],
      "file": {
        "/etc/hijpass/*": [
          "write"
        ],
        "/tmp/hijpass/log/*.log": [
          "write"
        ],
        "/tmp/hijserver/log/*.log": [
          "write"
        ],
        "/etc/init.d/hijpass restart": [
          "exec"
        ],
        "/usr/lib/hijpass/nft.sh reset": [
          "exec"
        ],
        "/usr/lib/hijpass/nft.sh show": [
          "exec"
        ],
        "/usr/bin/tail -n [0-9]* /tmp/hijpass/log/*.log": [
          "exec"
        ],
        "/usr/bin/tail -n [0-9]* /tmp/hijserver/log/*.log": [
          "exec"
        ],
        "/usr/lib/hijpass/rules.sh update": [
          "exec"
        ],
        "/usr/lib/hijpass/rules.sh query *": [
          "exec"
        ],
        "/usr/lib/hijpass/connect.sh https://* [0-9]*": [
          "exec"
        ],
        "/usr/lib/hijpass/net.sh port [0-9]*": [
          "exec"
        ],
        "/usr/lib/hijpass/net.sh ping [0-9]*": [
          "exec"
        ],
        "/usr/lib/hijpass/geoview.sh -e *": [
          "exec"
        ],
        "/usr/lib/hijpass/geoview.sh -l *": [
          "exec"
        ],
        "/usr/lib/hijpass/geoview.sh -t *": [
          "exec"
        ],
        "/usr/lib/hijpass/route-match.sh *": [
          "exec"
        ],
        "/usr/lib/hijpass/rm.sh proxy *": [
          "exec"
        ],
        "/usr/lib/hijpass/rm.sh proxy * *": [
          "exec"
        ],
        "/usr/lib/hijpass/rm.sh server *": [
          "exec"
        ],
        "/usr/lib/hijpass/rm.sh server * *": [
          "exec"
        ],
        "/bin/cat /proc/net/arp": [
          "exec"
        ],
        "/usr/lib/hijpass/core-update.sh version *": [
          "exec"
        ],
        "/usr/lib/hijpass/core-update.sh update *": [
          "exec"
        ]
      }
    }
  }
}
