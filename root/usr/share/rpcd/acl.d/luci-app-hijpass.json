{
  "luci-app-hijpass": {
    "description": "Grant access to hijpass configurations",
    "read": {
      "uci": [
        "hijpass",
        "hijserver",
        "dhcp"
      ],
      "ubus": {
        "service": [
          "list"
        ],
        "hijpass": [
          "firewall_chains",
          "editor_read",
          "log_list",
          "log_read",
          "log_settings",
          "defaults",
          "firewall_show",
          "network_connect",
          "network_ping",
          "rule_query",
          "rule_match",
          "geo_lookup",
          "geo_query",
          "trace_status",
          "core_version",
          "core_latest",
          "job_status"
        ]
      }
    },
    "write": {
      "uci": [
        "hijpass",
        "hijserver"
      ],
      "ubus": {
        "hijpass-config": [
          "render",
          "validate"
        ],
        "hijpass": [
          "editor_write",
          "config_write",
          "log_clear",
          "cleanup_node",
          "service_restart",
          "firewall_reset",
          "rule_update",
          "core_update",
          "trace_start",
          "trace_release",
          "job_release"
        ]
      }
    }
  }
}
