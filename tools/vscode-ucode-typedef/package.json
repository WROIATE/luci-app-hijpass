{
  "name": "ucode-typedef-navigation",
  "displayName": "ucode Typedef Navigation",
  "description": "Jump from ucode JSDoc type references to their local @typedef definitions.",
  "version": "0.1.0",
  "publisher": "hijpass-local",
  "private": true,
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.86.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:ucode"],
  "extensionKind": ["workspace"],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [{ "id": "ucode", "extensions": [".uc"], "aliases": ["ucode"] }]
  },
  "capabilities": {
    "untrustedWorkspaces": { "supported": true },
    "virtualWorkspaces": true
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test test/parser.test.cjs",
    "test:editor": "npm run compile && node test/run-editor.cjs",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/vscode": "1.86.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@azure/identity": {
      "@azure/msal-node": "7.1.2"
    }
  }
}
