{
  "compilerOptions": {
    "target": "es2017",
    "module": "esnext",
    "moduleResolution": "node",
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "useDefineForClassFields": true
  },
  "include": [
    "views/**/*.ts",
    "types/**/*.d.ts",
    "enum/**/*.ts",
    "module/**/*.ts",
    "utils/**/*.ts",
    "static/**/*.svg"
  ],
}